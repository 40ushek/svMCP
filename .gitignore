# Claude Code settings.
# Исключаем содержимое, а не саму папку: исключённую директорию git не обходит,
# и любое "!" внутри неё не работает. Пути привязаны к корню — без ведущего "/"
# шаблон со слэшем внутри перестал бы ловить .claude в подпапках.
/.claude/*
# ...кроме скилов: скил и его история (SKILL.md + HISTORY.md) версионируются
# вместе, чтобы откат возвращал согласованную пару.
!/.claude/skills/

# .claude в подпапках — только локальные настройки, версионировать нечего
src/.claude/

# Codex build artifacts
.codex-build/

# Local reference project
markAligner/

# Drawing/dimension cases: снимки реальных чертежей, вне репозитория
cases/
