<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeklaMcpServer.Api\TeklaMcpServer.Api.csproj" />
    <!-- The contact library lives in its own repository because its core must stay free
         of Tekla. Referenced here only so it can be exercised against a live model. -->
    <ProjectReference Include="..\..\..\SolidContacts\src\SolidContacts.Core\SolidContacts.Core.csproj" />
    <ProjectReference Include="..\..\..\SolidContacts\src\SolidContacts.Tekla\SolidContacts.Tekla.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" />
  </ItemGroup>

  <PropertyGroup>
    <TeklaExtensionsDir>C:\TeklaStructures\2025.0\Environments\common\extensions\svMCP\</TeklaExtensionsDir>
  </PropertyGroup>

  <Target Name="DeployToExtensions" AfterTargets="Build" Condition="Exists('$(TeklaExtensionsDir)')">
    <ItemGroup>
      <!-- app.config files are excluded on purpose. The working one in the extensions
           folder carries codeBase entries pointing at the installed Tekla assemblies and
           was written there by hand once; without it the NuGet copies load, their
           version 2025.0.0.0 goes into the remoting channel name instead of the
           installed 2025.0.52577.0, and nothing connects. Copying the build output over
           it silently breaks every tool in that folder, which is how this exclusion came
           to be needed. -->
      <HostOutput Include="$(OutputPath)*.*" Exclude="$(OutputPath)*.exe.config;$(OutputPath)*.dll.config" />
    </ItemGroup>
    <Copy SourceFiles="@(HostOutput)" DestinationFolder="$(TeklaExtensionsDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
